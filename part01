#include <stdio.h>

int main() {
    float nota, soma = 0, media;
    int i;

    for (i = 1; i <= 5; i++) {
        printf("Digite a nota do aluno %d: ", i);
        scanf("%f", &nota);

        soma += nota;
    }

    media = soma / 5;

    printf("\nMedia da turma: %.2f\n", media);

    return 0;
}
